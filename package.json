{
  "name": "@lucas-j-zheng/pi-source-control",
  "version": "0.2.0",
  "description": "Read-only Source Control diff reviewer for the Pi coding agent (/diff)",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/extension.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-j-zheng/pi-source-control.git"
  },
  "homepage": "https://github.com/lucas-j-zheng/pi-source-control#readme",
  "bugs": {
    "url": "https://github.com/lucas-j-zheng/pi-source-control/issues"
  },
  "author": "Lucas Zheng"
}
